# Build trees: the root build/, per-config trees (build_msvc/, build-asan/, ...), the IDE's, docs output
build/
build*/
cmake/build/
out/
docs/output/
session_data/
.buildlock
*.lock
!rust/Cargo.lock

# Everything a run writes: the .pb scenes, the .pb_coords.txt / .pb_meta.txt dumps, .3dm and joint dumps.
# Regenerated by any example or dataset run and read back by nothing in the tree; CLAUDE.md diffs the
# dumps against a clean checkout of the baseline commit, never against a committed copy.
data/output/
/translation_shell.json

# Rhino/GH sources for the top_to_side_snap_fit dataset, restored from cf79120^; export data/top_to_side_snap_fit.obj from them
data/snap_fit_sources/

# Compiler and linker output
*.o
*.obj
# ...but data/*.obj are Wavefront OBJ geometry, not MSVC object files. This rule once excluded all 46
# dataset meshes, so CI cloned the adjacency .txt files without the geometry they index into. 2.5 MB total.
!data/*.obj
*.slo
*.lo
*.gch
*.pch
*.so
*.dylib
*.dll
*.a
*.lib
*.la
*.lai
*.mod
*.smod
*.exe
*.out
*.app
*.bin
*.d
*.tlog
*.suo
*.db
*.db-shm
*.db-wal
*.opendb
*.ipch
.VC.db-shm
.VC.db-wal
*.manifest
*.spec

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# One-off build log captures: redirect build output to a scratch directory, not the repo.
build_*.txt
error_lines.txt
*.log

# Editor compile database: a symlink into the ignored build/ tree. Regenerate with
# `ln -sfn build/compile_commands.json compile_commands.json`.
/compile_commands.json

# Per-machine files, agent scratch state
.claude/settings.local.json
CLAUDE.local.md
.codex/
.env
